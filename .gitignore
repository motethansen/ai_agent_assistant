# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.env
# Environment / secrets
.env
.env.local
.env.*.local
*.env

# Google API Credentials (SECURITY)
credentials.json
token.json
client_secret.json

# macOS
.DS_Store

# User-specific
*.local
.config
datainput/
vector_db/

# Claude Code internals
.claude/settings.local.json
.claude/worktrees/

# Logs
logs/

# ── Generated runtime files (SECURITY) ───────────────────────────────────────
# Deny-all, allow by exception. The previous rule listed individual files to
# ignore, so every NEW artefact was tracked by default — which is how a derived
# index of the whole vault once ended up committed.
#
# Anything this app derives from the vault is private by construction: even an
# index that holds no note bodies still exposes every title and path. If you
# need to commit something under output/, add an explicit `!` exception below
# and be certain it holds no vault-derived content.
output/*
!output/.gitkeep

# Knowledge graphs and vault indexes — private wherever they land
*.ttl
.kg_mtimes.json
knowledge_graph.*
