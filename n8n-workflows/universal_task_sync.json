{
  "name": "Universal Task Sync",
  "nodes": [
    {
      "parameters": {
        "path": "task-sync",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-task-sync",
      "name": "Task Sync Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "universal-task-sync-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst tasks = body.tasks || [];\nconst events = body.calendar_events || [];\n\nconst eventMap = {};\nevents.forEach(e => {\n  const key = e.summary.trim().toLowerCase();\n  eventMap[key] = e;\n});\n\nconst taskMap = {};\ntasks.forEach(t => {\n  const key = t.title.trim().toLowerCase();\n  taskMap[key] = t;\n});\n\n// Tasks not yet in calendar\nconst toCreate = tasks.filter(t => !eventMap[t.title.trim().toLowerCase()]);\n// Calendar events not yet in task list  \nconst toAddLocally = events.filter(e => !taskMap[e.summary.trim().toLowerCase()]);\n// Already in both\nconst skipped = tasks.filter(t => eventMap[t.title.trim().toLowerCase()]);\n\nreturn [{\n  json: {\n    toCreate,\n    skipped,\n    toAddLocally,\n    task_count: tasks.length,\n    event_count: events.length\n  }\n}];"
      },
      "id": "classify-tasks",
      "name": "Classify Tasks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5000/webhook/add-event",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ events: $json.toCreate }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "create-events",
      "name": "Create Calendar Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [700, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5000/webhook/add-task",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ description: $json.summary, source: 'calendar' }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "add-local-tasks",
      "name": "Add Local Tasks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [700, 440]
    },
    {
      "parameters": {
        "jsCode": "// Collect results from Create Calendar Events and Add Local Tasks branches\n// then return a unified sync summary.\nconst classifyData = $node['Classify Tasks'].json;\nreturn [{ json: {\n  status: 'ok',\n  synced_at: new Date().toISOString(),\n  created_events: classifyData.toCreate.length,\n  added_tasks: classifyData.toAddLocally.length,\n  skipped: classifyData.skipped.length\n}}];"
      },
      "id": "build-response",
      "name": "Build Sync Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "sync-response",
      "name": "Sync Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1160, 300]
    }
  ],
  "connections": {
    "Task Sync Trigger": {
      "main": [[{ "node": "Classify Tasks", "type": "main", "index": 0 }]]
    },
    "Classify Tasks": {
      "main": [
        [
          { "node": "Create Calendar Events", "type": "main", "index": 0 },
          { "node": "Add Local Tasks", "type": "main", "index": 0 },
          { "node": "Build Sync Response", "type": "main", "index": 0 }
        ]
      ]
    },
    "Create Calendar Events": {
      "main": [[{ "node": "Build Sync Response", "type": "main", "index": 0 }]]
    },
    "Add Local Tasks": {
      "main": [[{ "node": "Build Sync Response", "type": "main", "index": 0 }]]
    },
    "Build Sync Response": {
      "main": [[{ "node": "Sync Response", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["agent", "sync", "universal"]
}
