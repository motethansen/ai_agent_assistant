{
  "name": "Friday Backlog Digest",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * 5"
            }
          ]
        }
      },
      "id": "cron-friday",
      "name": "Friday 17:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 200]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "backlog-digest",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-backlog",
      "name": "On-Demand Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 420],
      "webhookId": "backlog-digest-ondemand-webhook"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:5000/webhook/backlog",
        "options": {
          "timeout": 15000
        }
      },
      "id": "fetch-backlog",
      "name": "Fetch Backlog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "jsCode": "const tasks = $input.first().json.tasks || [];\n\n// Group by category\nconst groups = {};\ntasks.forEach(t => {\n  const cat = t.category || t.source || 'Uncategorised';\n  if (!groups[cat]) groups[cat] = [];\n  groups[cat].push(t);\n});\n\n// Sort categories, overdue first\nconst lines = [];\nconst today = new Date().toISOString().slice(0,10);\n\n// Overdue section\nconst overdue = tasks.filter(t => t.due_date && t.due_date < today);\nif (overdue.length) {\n  lines.push(`### ⚠️  Overdue (${overdue.length})`);\n  overdue.forEach(t => lines.push(`- [${t.category || t.source}] ${t.task} (due ${t.due_date})`));\n  lines.push('');\n}\n\n// By category\nObject.entries(groups).sort().forEach(([cat, items]) => {\n  lines.push(`### ${cat} (${items.length})`);\n  items.forEach(t => lines.push(`- ${t.task}`));\n  lines.push('');\n});\n\nreturn [{ json: {\n  digest: lines.join('\\n'),\n  count: tasks.length,\n  overdue_count: overdue.length,\n  category_count: Object.keys(groups).length\n}}];"
      },
      "id": "format-digest",
      "name": "Format Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "output",
              "value": "={{ `Backlog digest — ${$json.count} tasks across ${$json.category_count} categories (${$json.overdue_count} overdue):\\n\\n${$json.digest}` }}"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-output",
      "name": "Prepare Output",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [940, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-backlog",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1160, 300]
    }
  ],
  "connections": {
    "Friday 17:00": {
      "main": [[{ "node": "Fetch Backlog", "type": "main", "index": 0 }]]
    },
    "On-Demand Trigger": {
      "main": [[{ "node": "Fetch Backlog", "type": "main", "index": 0 }]]
    },
    "Fetch Backlog": {
      "main": [[{ "node": "Format Digest", "type": "main", "index": 0 }]]
    },
    "Format Digest": {
      "main": [[{ "node": "Prepare Output", "type": "main", "index": 0 }]]
    },
    "Prepare Output": {
      "main": [[{ "node": "Return Result", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["agent", "backlog", "digest", "weekly"]
}
