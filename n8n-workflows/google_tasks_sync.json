{
  "name": "Google Tasks Sync",
  "nodes": [
    {
      "parameters": {
        "path": "google-tasks-pull",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "id": "pull-trigger",
      "name": "Pull Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [100, 200]
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "getAll",
        "taskList": "@default",
        "returnAll": true,
        "filters": {
          "showCompleted": false
        }
      },
      "id": "get-google-tasks",
      "name": "Get Google Tasks",
      "type": "n8n-nodes-base.googleTasks",
      "typeVersion": 1,
      "position": [320, 200],
      "credentials": {
        "googleTasksOAuth2Api": {
          "id": "google-tasks-creds",
          "name": "Google Tasks Account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5678/webhook/add-task",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{"description": "={{$json.title}}", "date": "={{$json.due ? $json.due.split('T')[0] : ''}}"}",
        "options": {}
      },
      "id": "add-to-python",
      "name": "Add to Python",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [540, 200]
    },
    {
      "parameters": {
        "path": "google-tasks-push",
        "options": {},
        "httpMethod": "POST",
        "responseMode": "onReceived"
      },
      "id": "push-trigger",
      "name": "Push Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [100, 400]
    },
    {
      "parameters": {
        "jsCode": "const completions = $json.body.completions || [];
return completions.map(c => ({ json: { title: c } }));"
      },
      "id": "parse-completions",
      "name": "Parse Completions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 400]
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "update",
        "taskList": "@default",
        "task": "={{$node['Find Task'].json.id}}",
        "updateFields": {
          "status": "completed"
        }
      },
      "id": "mark-complete",
      "name": "Mark Complete",
      "type": "n8n-nodes-base.googleTasks",
      "typeVersion": 1,
      "position": [760, 400],
      "credentials": {
        "googleTasksOAuth2Api": {
          "id": "google-tasks-creds",
          "name": "Google Tasks Account"
        }
      }
    },
    {
      "parameters": {
        "resource": "task",
        "operation": "getAll",
        "taskList": "@default",
        "returnAll": true,
        "filters": {
          "showCompleted": false
        }
      },
      "id": "find-task",
      "name": "Find Task",
      "type": "n8n-nodes-base.googleTasks",
      "typeVersion": 1,
      "position": [540, 400],
      "credentials": {
        "googleTasksOAuth2Api": {
          "id": "google-tasks-creds",
          "name": "Google Tasks Account"
        }
      }
    }
  ],
  "connections": {
    "Pull Trigger": {
      "main": [
        [
          {
            "node": "Get Google Tasks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Google Tasks": {
      "main": [
        [
          {
            "node": "Add to Python",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Push Trigger": {
      "main": [
        [
          {
            "node": "Parse Completions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Completions": {
      "main": [
        [
          {
            "node": "Find Task",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Task": {
      "main": [
        [
          {
            "node": "Mark Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
