{
  "name": "Agent — Morning Sync Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agent/morning-sync",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-morning-sync",
      "name": "Morning Sync Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "agent-morning-sync-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5000/webhook/agent/morning-sync",
        "options": {
          "timeout": 120000
        }
      },
      "id": "call-morning-sync",
      "name": "Run Morning Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "check-status",
      "name": "Pipeline OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const steps = $json.steps || {};\nconst errors = Object.entries(steps).filter(([k,v]) => v.toString().startsWith('error'));\nconst ok = Object.entries(steps).filter(([k,v]) => v === 'ok');\nreturn [{ json: {\n  status: 'ok',\n  steps_ok: ok.map(([k]) => k),\n  steps_error: errors.map(([k,v]) => `${k}: ${v}`),\n  plan_preview: ($json.plan || '').slice(0, 300),\n  suggestions_file: $json.suggestions_file\n}}];"
      },
      "id": "format-success",
      "name": "Format Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "status",
              "value": "error"
            },
            {
              "name": "message",
              "value": "={{ 'Morning pipeline failed: ' + JSON.stringify($json) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "format-error",
      "name": "Format Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-morning",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Morning Sync Trigger": {
      "main": [[{ "node": "Run Morning Pipeline", "type": "main", "index": 0 }]]
    },
    "Run Morning Pipeline": {
      "main": [[{ "node": "Pipeline OK?", "type": "main", "index": 0 }]]
    },
    "Pipeline OK?": {
      "main": [
        [{ "node": "Format Success", "type": "main", "index": 0 }],
        [{ "node": "Format Error", "type": "main", "index": 0 }]
      ]
    },
    "Format Success": {
      "main": [[{ "node": "Return Result", "type": "main", "index": 0 }]]
    },
    "Format Error": {
      "main": [[{ "node": "Return Result", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["agent", "morning", "pipeline", "webhook"]
}
