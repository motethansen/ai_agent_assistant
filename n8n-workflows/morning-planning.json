{
  "name": "Morning Planning",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      },
      "id": "cron-morning",
      "name": "Weekday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:5678/webhook/plan",
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "options": {}
      },
      "id": "http-plan",
      "name": "Request Daily Plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "if-ok",
      "name": "Plan OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "summary",
              "value": "={{ \"Today's plan:\\n\" + ($json.schedule || []).map(s => `- [${s.time}] ${s.task} (${s.category})`).join('\\n') }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-summary",
      "name": "Format Schedule",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 220]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error",
              "value": "={{ \"Planning failed: \" + $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-error",
      "name": "Log Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Weekday 08:00": {
      "main": [
        [
          {
            "node": "Request Daily Plan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request Daily Plan": {
      "main": [
        [
          {
            "node": "Plan OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Plan OK?": {
      "main": [
        [
          {
            "node": "Format Schedule",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["agent", "planning", "morning"]
}
