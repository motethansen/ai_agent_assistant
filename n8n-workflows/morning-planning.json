{
  "name": "Morning Planning",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1-5"
            }
          ]
        }
      },
      "id": "cron-morning",
      "name": "Weekday 08:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:5678/webhook/morning-plan",
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "options": {}
      },
      "id": "http-morning-plan",
      "name": "Run Morning Plan Pipeline",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "ok"
            }
          ]
        }
      },
      "id": "if-ok",
      "name": "Plan OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "summary",
              "value": "={{ \"Morning plan ready.\\nSteps: \" + JSON.stringify($json.steps) + \"\\n\\n\" + ($json.plan || '(no plan text)').slice(0, 500) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-summary",
      "name": "Format Plan Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 220]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "error",
              "value": "={{ \"Morning plan failed. Steps: \" + JSON.stringify($json.steps) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-error",
      "name": "Log Error",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Weekday 08:00": {
      "main": [
        [
          {
            "node": "Run Morning Plan Pipeline",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Morning Plan Pipeline": {
      "main": [
        [
          {
            "node": "Plan OK?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Plan OK?": {
      "main": [
        [
          {
            "node": "Format Plan Summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["agent", "planning", "morning"]
}
