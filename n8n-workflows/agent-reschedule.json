{
  "name": "Agent — Reschedule Overdue Tasks",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agent/reschedule",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-reschedule",
      "name": "Reschedule Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "agent-reschedule-webhook"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || $json;\nconst target = body.target || '';\nif (!target) {\n  return [{ json: { error: 'Missing required field: target' } }];\n}\nreturn [{ json: { target, dry_run: body.dry_run || false, logseq: body.logseq !== false, obsidian: body.obsidian !== false, filter_text: body.filter_text || null } }];"
      },
      "id": "validate-input",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:5000/webhook/agent/reschedule",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "call-reschedule-agent",
      "name": "Run Reschedule Agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-reschedule",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Reschedule Trigger": {
      "main": [[{ "node": "Validate Input", "type": "main", "index": 0 }]]
    },
    "Validate Input": {
      "main": [[{ "node": "Run Reschedule Agent", "type": "main", "index": 0 }]]
    },
    "Run Reschedule Agent": {
      "main": [[{ "node": "Return Result", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": ["agent", "tasks", "reschedule", "webhook"]
}
