{
  "name": "Add Task via Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "n8n-trigger/add-task",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Inbound Add-Task",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "add-task-webhook"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:5678/webhook/add-task",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify({ description: $json.body.task, date: $json.body.date || undefined }) }}",
        "options": {}
      },
      "id": "http-add-task",
      "name": "Add Task to LogSeq",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Return Result",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Inbound Add-Task": {
      "main": [
        [
          {
            "node": "Add Task to LogSeq",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Add Task to LogSeq": {
      "main": [
        [
          {
            "node": "Return Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["agent", "tasks", "webhook"]
}
