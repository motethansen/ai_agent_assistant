# .config template - copy this to .config and fill in your details.
# DO NOT COMMIT THE REAL .config FILE TO GITHUB.
# This is the SINGLE source of truth for all configuration.

# --- Google Gemini API Settings ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Google Calendar Settings ---
CALENDAR_ID=primary

# --- OpenClaw Settings ---
# Run `openclaw config get gateway.auth.token` to get the API key.
OPENCLAW_API_KEY=your_openclaw_api_key_here
OPENCLAW_ENDPOINT=http://localhost:18789/v1
# OPENCLAW_MODEL: Model name used by OpenClaw (OpenAI-compatible).
OPENCLAW_MODEL=gpt-3.5-turbo

# --- Ollama Settings ---
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX: Context window size for Ollama models.
OLLAMA_NUM_CTX=8192

# --- Optional Cloud API Settings ---
OPENAI_API_KEY=your_openai_api_key_here
CLAUDE_API_KEY=your_claude_api_key_here

# --- RAG & Book Agent Settings ---
# HF_TOKEN: Hugging Face token for faster model downloads and higher rate limits.
HF_TOKEN=your_huggingface_token_here

# --- Apple Reminders Settings ---
APPLE_REMINDERS_LIST=Reminders

# --- General Settings ---
# WORKSPACE_DIR: The absolute path to your Obsidian vault or Markdown notes folder.
# Example (Mac): /Users/yourname/Documents/ObsidianVault
# Example (Linux): /home/yourname/Notes
WORKSPACE_DIR=/path/to/your/markdown/notes
LOGSEQ_DIR=/path/to/your/logseq/graph
BOOKS_DIR=/path/to/your/books/folder
DEBOUNCE_SECONDS=5

# --- LLM Activation (Set to true or false) ---
ENABLE_OLLAMA=true
ENABLE_OPENCLAW=true
ENABLE_GEMINI=false
ENABLE_OPENAI=false
ENABLE_CLAUDE=false

# --- Model Routing ---
# Which LLM handles which task: ollama, openclaw, gemini, openai, claude
ROUTING_SCHEDULING=openclaw
ROUTING_PARSING=ollama
ROUTING_CHAT=openclaw

# --- LLM Priority ---
# Comma-separated fallback order when the preferred model is unavailable.
LLM_PRIORITY=openclaw, gemini, ollama

# --- User Productivity Preferences ---
# CHRONOTYPE: morning_owl, night_owl, or balanced
CHRONOTYPE=morning_owl
# DEEP_WORK_START/END: Preferred time window for high-focus tasks (e.g., 09:00, 17:00)
DEEP_WORK_START=09:00
DEEP_WORK_END=12:00
# FOCUS_CATEGORIES: Comma-separated list of categories that require deep work
FOCUS_CATEGORIES=winedragons,writing academic papers,dev,learning Thai
