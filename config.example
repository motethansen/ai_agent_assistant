# Copy this file to .config and fill in your paths and model names.
# DO NOT COMMIT .config TO GIT — it contains your API keys.

# ── LM Studio (primary local LLM — https://lmstudio.ai) ──────────────────────
# Download LM Studio, load a model, and enable the local server on port 1234.
ENABLE_LM_STUDIO=true
LM_STUDIO_MODEL=qwen2.5-coder-7b-instruct-mlx

# ── Ollama (alternative local LLM — https://ollama.com) ──────────────────────
# Set ENABLE_OLLAMA=true and ENABLE_LM_STUDIO=false to use Ollama instead.
ENABLE_OLLAMA=false
OLLAMA_MODEL=llama3:latest
OLLAMA_HOST=http://localhost:11434

# ── Notes directories ─────────────────────────────────────────────────────────
WORKSPACE_DIR=/path/to/your/obsidian/vault
LOGSEQ_DIR=/path/to/your/logseq/graph
OBSIDIAN_PLANNER_FILE=Planner.md      # relative path inside WORKSPACE_DIR
LOGSEQ_JOURNAL_DAYS=30                # how many recent journal days to scan

# ── Planning preferences ──────────────────────────────────────────────────────
CHRONOTYPE=morning_owl                # morning_owl | night_owl | balanced
DEEP_WORK_START=09:00
DEEP_WORK_END=12:00
FOCUS_CATEGORIES=dev,writing,learning # comma-separated focus areas

# ── LLM routing ───────────────────────────────────────────────────────────────
ROUTING_CHAT=lmstudio
ROUTING_SCHEDULING=lmstudio
ROUTING_PARSING=lmstudio
ROUTING_PLANNING=lmstudio
LLM_PRIORITY=lmstudio,gemini,openai,claude

# ── Cloud API keys (optional — fallback only) ─────────────────────────────────
ENABLE_GEMINI=false
# GEMINI_API_KEY=your_key_here

ENABLE_OPENAI=false
# OPENAI_API_KEY=your_key_here

ENABLE_CLAUDE=false
# CLAUDE_API_KEY=your_key_here

# ── Local ICS calendar (no credentials required) ─────────────────────────────
LOCAL_CALENDAR_FILE=datainput/local_calendar.ics

# ── Google Tasks two-way sync (via n8n) ───────────────────────────────────────
# Google Calendar and Tasks credentials are managed in n8n — see INSTALL.md
ENABLE_GOOGLE_TASKS=false
GOOGLE_TASKS_LIST=@default
ENABLE_GOOGLE_CALENDAR=false

# ── n8n workflow automation (optional) ────────────────────────────────────────
# docker compose up -d n8n   →   http://localhost:5679
# python api_server.py       →   http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5679/webhook
WEBHOOK_PORT=5678

# ── Apple Calendar integration (macOS only) ───────────────────────────────────
# Name of the Apple Calendar to push events to when using /add-event
# Run /ask lmstudio list my calendars  or check the Calendar app for the name
APPLE_CALENDAR_NAME=Home
