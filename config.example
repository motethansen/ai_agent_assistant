# AI Agent Assistant — configuration template
# Copy to .config and fill in your values:  cp config.example .config
# Or run the interactive setup:             ./install.sh
#
# DO NOT COMMIT .config — it contains your API keys (.gitignore already covers it)

# ── Paths (required) ──────────────────────────────────────────────────────────

WORKSPACE_DIR=/path/to/your/obsidian/vault
LOGSEQ_DIR=/path/to/your/logseq/graph

# File names are relative to WORKSPACE_DIR
OBSIDIAN_DASHBOARD_FILE=Dashboard.md

# How many recent LogSeq journal days to scan on each sync
LOGSEQ_JOURNAL_DAYS=2

# ── LLM routing ───────────────────────────────────────────────────────────────
# Assign a provider to each task type. Available values:
#   gemini-flash  → Gemini 2.0 Flash (free tier, fast)
#   gemini-pro    → Gemini 2.5 Flash (free tier, better quality for planning)
#   groq          → Groq Llama 3.3 70B (free tier, very fast)
#   deepseek      → DeepSeek V3/R1 (free trial credits, strong reasoning)
#   ollama        → Local Ollama (only if OLLAMA_ENABLED=true)

ROUTING_CHAT=gemini-flash        # interactive chat + Q&A
ROUTING_PLANNING=gemini-pro      # day/week schedule generation
ROUTING_NOTES=gemini-flash       # note organisation + wikilink suggestions
ROUTING_QUICK=groq               # fast one-liners, task parsing
ROUTING_REASONING=deepseek       # deep analysis, complex reasoning

# ── Gemini (Google AI Studio — free tier) ─────────────────────────────────────
# Get your free API key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.5-flash-preview-04-17

# ── Groq (free tier) ─────────────────────────────────────────────────────────
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── DeepSeek (free trial credits, then ~$0.14/1M tokens) ─────────────────────
# Sign up at: https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Ollama (local — optional) ─────────────────────────────────────────────────
# Set to true only if Ollama is installed (install.sh can do this for you)
OLLAMA_ENABLED=false
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# ── Planning preferences ──────────────────────────────────────────────────────
CHRONOTYPE=morning_owl           # morning_owl | night_owl | balanced
DEEP_WORK_START=09:00
DEEP_WORK_END=12:00
FOCUS_CATEGORIES=dev,writing,learning

# ── Sync ──────────────────────────────────────────────────────────────────────
# How often the background sync agent runs (LogSeq → Obsidian)
SYNC_INTERVAL_MINUTES=30

# ── Calendar ──────────────────────────────────────────────────────────────────
# Tasks tagged #gcal in Obsidian are synced to calendar
# Change the tag if you prefer a different label (e.g. cal, calendar)
GCAL_TAG=gcal

# ICS file — always generated as a drag-drop fallback (no credentials needed)
LOCAL_CALENDAR_FILE=output/local_calendar.ics

# Google Calendar API (optional — ICS export always works without this)
# Set to true and provide a credentials JSON file to push events directly
GOOGLE_CAL_ENABLED=false
GOOGLE_CAL_CREDENTIALS=

# Apple Calendar (macOS only) — name of the calendar to push events to
APPLE_CALENDAR_NAME=Home
